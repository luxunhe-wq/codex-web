# bash deploy.sh creates .env.docker automatically from this template.
# Advanced manual use: docker compose --env-file .env.docker ...
# Host port; container port remains 8080. Published on host loopback only.
CODEX_WEB_PUBLISH_PORT=8080
CODEX_VERSION=0.159.2
# Match your Linux user's id -u / id -g when bind-mounting host projects.
CODEX_WEB_UID=1000
CODEX_WEB_GID=1000
# For HTTPS, add your domain here and set Secure Cookie to 1.
CODEX_WEB_ALLOWED_HOSTS=localhost,127.0.0.1
CODEX_WEB_SECURE_COOKIE=0
