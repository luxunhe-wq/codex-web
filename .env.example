# Copy to .env. Literal values; no shell expansion. Environment variables take precedence.
CODEX_WEB_HOST=127.0.0.1
CODEX_WEB_PORT=8080
# Optional absolute paths (defaults: repository/data, repository, codex on PATH).
# CODEX_WEB_DATA=/home/your-user/.local/share/codex-web
# CODEX_WEB_CWD=/home/your-user/projects
# CODEX_WEB_CODEX_BIN=/home/your-user/.local/bin/codex
# CODEX_HOME=/home/your-user/.codex
# Enable both options only when accessing via HTTPS reverse proxy.
CODEX_WEB_SECURE_COOKIE=0
# CODEX_WEB_ALLOWED_HOSTS=codex.example.com
